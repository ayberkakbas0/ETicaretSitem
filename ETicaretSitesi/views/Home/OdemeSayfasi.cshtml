@model ETicaretSitesi.models.Siparis
@{
    ViewData["Title"] = "Ödeme Sayfası";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-credit-card"></i> Ödeme Bilgileri
                    </h5>
                </div>
                <div class="card-body">
                    @if (TempData["Hata"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @TempData["Hata"]
                        </div>
                    }

                    <form method="post" action="/Odeme/OdemeYap" id="odemeForm">
                        <input type="hidden" name="siparisId" value="@Model.Id" />

                       
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">Ödeme Yöntemi Seçin:</h6>
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <input type="radio" class="btn-check" name="odemeYontemi" id="krediKarti" value="Kredi Kartı" checked>
                                    <label class="btn btn-outline-primary w-100" for="krediKarti">
                                        <i class="bi bi-credit-card"></i> Kredi Kartı
                                    </label>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <input type="radio" class="btn-check" name="odemeYontemi" id="havale" value="Havale">
                                    <label class="btn btn-outline-primary w-100" for="havale">
                                        <i class="bi bi-bank"></i> Havale
                                    </label>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <input type="radio" class="btn-check" name="odemeYontemi" id="kapidaOdeme" value="Kapıda Ödeme">
                                    <label class="btn btn-outline-primary w-100" for="kapidaOdeme">
                                        <i class="bi bi-cash"></i> Kapıda Ödeme
                                    </label>
                                </div>
                            </div>
                        </div>

                        
                        <div id="krediKartiBilgileri">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="kartSahibi" class="form-label">Kart Sahibi</label>
                                    <input type="text" class="form-control" id="kartSahibi" name="kartSahibi" placeholder="Ad Soyad" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="kartNumarasi" class="form-label">Kart Numarası</label>
                                    <input type="text" class="form-control" id="kartNumarasi" name="kartNumarasi" placeholder="1234 5678 9012 3456" maxlength="19" required>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="sonKullanmaTarihi" class="form-label">Son Kullanma Tarihi</label>
                                    <input type="text" class="form-control" id="sonKullanmaTarihi" name="sonKullanmaTarihi" placeholder="MM/YY" maxlength="5" required>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="cvv" class="form-label">CVV</label>
                                    <input type="text" class="form-control" id="cvv" name="cvv" placeholder="123" maxlength="3" required>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="d-flex gap-2">
                                        <i class="bi bi-credit-card text-primary fs-4"></i>
                                        <i class="bi bi-shield-check text-success fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                       
                        <div id="havaleBilgileri" style="display: none;">
                            <div class="alert alert-info">
                                <h6><i class="bi bi-bank"></i> Havale Bilgileri</h6>
                                <p class="mb-1"><strong>Banka:</strong> Örnek Bank</p>
                                <p class="mb-1"><strong>IBAN:</strong> TR12 3456 7890 1234 5678 9012 34</p>
                                <p class="mb-1"><strong>Alıcı:</strong> E-Ticaret Şirketi</p>
                                <p class="mb-0"><strong>Açıklama:</strong> Sipariş No: @Model.Id</p>
                            </div>
                        </div>

                        
                        <div id="kapidaOdemeBilgileri" style="display: none;">
                            <div class="alert alert-warning">
                                <h6><i class="bi bi-cash"></i> Kapıda Ödeme</h6>
                                <p class="mb-0">Ürünleriniz teslim edilirken ödeme yapabilirsiniz. Ek ücret: ₺5.00</p>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Ödemeyi Tamamla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-receipt"></i> Sipariş Özeti
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">Sipariş No:</small>
                        <div class="fw-bold">#@Model.Id</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Sipariş Tarihi:</small>
                        <div>@Model.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h6>Ürünler:</h6>
                        @foreach (var detay in Model.SiparisDetaylari)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <div class="fw-bold">@detay.Urun.Ad</div>
                                    <small class="text-muted">@detay.Adet adet x ₺@detay.BirimFiyat</small>
                                </div>
                                <div class="fw-bold">₺@detay.ToplamFiyat</div>
                            </div>
                        }
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Ara Toplam:</span>
                        <span>₺@Model.ToplamTutar</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Kargo:</span>
                        <span>₺0.00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Toplam:</span>
                        <span class="fw-bold fs-5 text-primary">₺@Model.ToplamTutar</span>
                    </div>
                </div>
            </div>

            
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle"></i> Test Kartları
                    </h6>
                </div>
                <div class="card-body">
                    <small class="text-muted">
                        <strong>Başarılı Ödeme:</strong><br>
                        4111 1111 1111 1111<br>
                        5555 5555 5555 4444<br><br>
                        <strong>Başarısız Ödeme:</strong><br>
                        4000 0000 0000 0002<br><br>
                        <strong>CVV:</strong> Herhangi 3 haneli sayı
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    
    document.querySelectorAll('input[name="odemeYontemi"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            var yontem = this.value;

            
            document.getElementById('krediKartiBilgileri').style.display = 'none';
            document.getElementById('havaleBilgileri').style.display = 'none';
            document.getElementById('kapidaOdemeBilgileri').style.display = 'none';

            
            if (yontem === 'Kredi Kartı') {
                document.getElementById('krediKartiBilgileri').style.display = 'block';
            } else if (yontem === 'Havale') {
                document.getElementById('havaleBilgileri').style.display = 'block';
            } else if (yontem === 'Kapıda Ödeme') {
                document.getElementById('kapidaOdemeBilgileri').style.display = 'block';
            }
        });
    });

    
    document.getElementById('kartNumarasi').addEventListener('input', function () {
        var value = this.value.replace(/\s/g, '').replace(/\D/g, '');
        var formattedValue = value.replace(/(\d{4})(?=\d)/g, '$1 ');
        this.value = formattedValue;
    });

    
    document.getElementById('sonKullanmaTarihi').addEventListener('input', function () {
        var value = this.value.replace(/\D/g, '');
        if (value.length >= 2) {
            value = value.substring(0, 2) + '/' + value.substring(2, 4);
        }
        this.value = value;
    });

    
    document.getElementById('cvv').addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '');
    });

    
    document.getElementById('odemeForm').addEventListener('submit', function (e) {
        var odemeYontemi = document.querySelector('input[name="odemeYontemi"]:checked').value;

        if (odemeYontemi === 'Kredi Kartı') {
            var kartSahibi = document.getElementById('kartSahibi').value.trim();
            var kartNumarasi = document.getElementById('kartNumarasi').value.trim();
            var sonKullanmaTarihi = document.getElementById('sonKullanmaTarihi').value.trim();
            var cvv = document.getElementById('cvv').value.trim();

            if (!kartSahibi || !kartNumarasi || !sonKullanmaTarihi || !cvv) {
                e.preventDefault();
                alert('Lütfen tüm kart bilgilerini doldurun.');
                return false;
            }

            if (kartNumarasi.replace(/\s/g, '').length !== 16) {
                e.preventDefault();
                alert('Kart numarası 16 haneli olmalıdır.');
                return false;
            }

            if (cvv.length !== 3) {
                e.preventDefault();
                alert('CVV 3 haneli olmalıdır.');
                return false;
            }
        }
    });
</script> 