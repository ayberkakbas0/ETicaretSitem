@{
    ViewData["Title"] = "Admin Paneli";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">
                                <i class="bi bi-shield-check"></i> Admin Paneli
                            </h3>
                            <p class="mb-0">Hoş geldiniz, @Context.Session.GetString("KullaniciAd") @Context.Session.GetString("KullaniciSoyad")</p>
                        </div>
                        <div>
                            <a href="/Admin/AdminLogout" class="btn btn-outline-light">
                                <i class="bi bi-box-arrow-right"></i> Admin Çıkış
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-@TempData["MesajTipi"] alert-dismissible fade show" role="alert">
            @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill fs-1"></i>
                    <h3 class="mt-2">@ViewBag.ToplamKullanici</h3>
                    <p class="mb-0">Toplam Kullanıcı</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam-fill fs-1"></i>
                    <h3 class="mt-2">@ViewBag.ToplamUrun</h3>
                    <p class="mb-0">Toplam Ürün</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <i class="bi bi-chat-dots-fill fs-1"></i>
                    <h3 class="mt-2">@ViewBag.ToplamYorum</h3>
                    <p class="mb-0">Toplam Yorum</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                    <h3 class="mt-2">@ViewBag.OnayliYorum</h3>
                    <p class="mb-0">Onaylı Yorum</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-gear"></i> Hızlı Erişim
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a href="/Admin/YorumYonetimi" class="btn btn-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                                <i class="bi bi-chat-dots fs-1 mb-2"></i>
                                <span>Yorum Yönetimi</span>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/Admin/KullaniciYonetimi" class="btn btn-success w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                                <i class="bi bi-people fs-1 mb-2"></i>
                                <span>Kullanıcı Yönetimi</span>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/Admin/SiparisYonetimi" class="btn btn-warning w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                                <i class="bi bi-box-seam fs-1 mb-2"></i>
                                <span>Sipariş Yönetimi</span>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/Home/Index" class="btn btn-info w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                                <i class="bi bi-house fs-1 mb-2"></i>
                                <span>Site Önizleme</span>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/Admin/AdminLogout" class="btn btn-danger w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4">
                                <i class="bi bi-box-arrow-right fs-1 mb-2"></i>
                                <span>Admin Çıkış</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history"></i> Son Yorumlar
                    </h5>
                </div>
                <div class="card-body">
                    @{
                        var sonYorumlar = ViewBag.SonYorumlar as List<ETicaretSitesi.models.Yorum>;
                    }
                    @if (sonYorumlar != null && sonYorumlar.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var yorum in sonYorumlar.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">@yorum.Kullanici.Ad @yorum.Kullanici.Soyad</div>
                                        <small class="text-muted">@yorum.Metin.Substring(0, Math.Min(50, yorum.Metin.Length))...</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@yorum.Tarih.ToString("dd.MM")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Henüz yorum bulunmuyor.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up"></i> Yorum İstatistikleri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Onaylı Yorumlar</span>
                            <span class="badge bg-success">@ViewBag.OnayliYorum</span>
                        </div>
                        <div class="progress">
                            @{
                                var onayliYuzde = ViewBag.ToplamYorum > 0 ? (ViewBag.OnayliYorum * 100.0 / ViewBag.ToplamYorum) : 0;
                            }
                            <div class="progress-bar bg-success" style="width: @onayliYuzde%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Bekleyen Yorumlar</span>
                            <span class="badge bg-warning">@ViewBag.BekleyenYorum</span>
                        </div>
                        <div class="progress">
                            @{
                                var bekleyenYuzde = ViewBag.ToplamYorum > 0 ? (ViewBag.BekleyenYorum * 100.0 / ViewBag.ToplamYorum) : 0;
                            }
                            <div class="progress-bar bg-warning" style="width: @bekleyenYuzde%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> 