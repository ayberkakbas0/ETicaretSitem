@model ETicaretSitesi.models.Urun
@{
    ViewData["Title"] = Model.Ad;
    var yorumlar = ViewBag.Yorumlar as List<ETicaretSitesi.models.Yorum>;
    var ortalamaPuan = ViewBag.OrtalamaPuan as double? ?? 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm rounded mb-4">
        <a class="navbar-brand fw-bold" href="/Home/Index">E-Ticaret Sitem</a>
        <div class="navbar-nav ms-auto">
            @if (Context.Session.GetString("KullaniciId") != null)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i> @Context.Session.GetString("KullaniciAd")
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/Auth/Profile"><i class="bi bi-person"></i> Profilim</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/Auth/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/Auth/Login" class="btn btn-outline-primary me-2">
                    <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
                </a>
                <a href="/Auth/Register" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i> Kayıt Ol
                </a>
            }
        </div>
    </nav>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-@(TempData["MesajTipi"] ?? "info") alert-dismissible fade show" role="alert">
            <i class="bi bi-@(TempData["MesajTipi"] == "success" ? "check-circle" :
                          TempData["MesajTipi"] == "danger" ? "exclamation-triangle" :
                          TempData["MesajTipi"] == "warning" ? "exclamation-circle" : "info-circle")"></i>
            @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home/Index">Ana Sayfa</a></li>
            <li class="breadcrumb-item"><a href="/Home/Index?kategori=@Model.KategoriId">@Model.Kategori?.Isim</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Ad</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Ürün Resmi -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <img src="@(string.IsNullOrEmpty(Model.ResimUrl) ? "/images/default.png" : Model.ResimUrl)"
                     class="card-img-top" alt="@Model.Ad" style="max-height: 400px; object-fit: cover;" />
            </div>
        </div>

        <!-- Ürün Bilgileri -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title text-primary">@Model.Ad</h2>

                    <!-- Kategori -->
                    <span class="badge bg-secondary mb-3">@Model.Kategori?.Isim</span>

                    <!-- Puan -->
                    <div class="mb-3">
                        @if (ortalamaPuan > 0)
                        {
                            <div class="d-flex align-items-center">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= ortalamaPuan)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else if (i - ortalamaPuan < 1)
                                    {
                                        <i class="bi bi-star-half text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-warning"></i>
                                    }
                                }
                                <span class="ms-2 text-muted">(@ortalamaPuan.ToString("F1") / 5)</span>
                                <span class="ms-2 text-muted">(@yorumlar.Count yorum)</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Henüz yorum yapılmamış</span>
                        }
                    </div>

                    <!-- Fiyat -->
                    <div class="mb-3">
                        <h3 class="text-success fw-bold">₺@Model.Fiyat.ToString("N2")</h3>
                    </div>

                    <!-- Stok Durumu -->
                    <div class="mb-3">
                        @if (Model.Stok > 0)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i> Stokta (@Model.Stok adet)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle"></i> Stokta Yok
                            </span>
                        }
                    </div>

                    <!-- Açıklama -->
                    <div class="mb-4">
                        <h5>Açıklama:</h5>
                        <p class="text-muted">@Model.Aciklama</p>
                    </div>

                    <!-- Butonlar -->
                    <div class="d-grid gap-2">
                        @if (Model.Stok > 0)
                        {
                            <form method="post" action="/Home/SepeteEkle">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="urunId" value="@Model.Id" />
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-cart-plus"></i> Sepete Ekle
                                </button>
                            </form>
                        }
                        <button class="btn btn-outline-info" onclick="yorumModalAc(@Model.Id, '@Model.Ad')">
                            <i class="bi bi-chat-dots"></i> Yorum Yap
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Yorumlar Bölümü -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-dots"></i> Yorumlar (@yorumlar.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (yorumlar.Any())
                    {
                        foreach (var yorum in yorumlar)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">@yorum.Kullanici.Ad @yorum.Kullanici.Soyad</h6>
                                        <div class="mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= yorum.Puan)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            }
                                            <span class="ms-2 text-muted">@yorum.Tarih.ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>
                                        <p class="mb-0">@yorum.Metin</p>
                                    </div>
                                    @if (Context.Session.GetString("KullaniciId") == yorum.KullaniciId.ToString())
                                    {
                                        <button class="btn btn-sm btn-outline-danger" onclick="yorumSil(@yorum.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-chat-dots fs-1"></i>
                            <p class="mt-2">Bu ürün için henüz yorum yapılmamış.</p>
                            <p>İlk yorumu siz yapın!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yorum Modal -->
<div class="modal fade" id="yorumModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-dots"></i> Yorum Yap
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Yorum/Ekle">
                <div class="modal-body">
                    <input type="hidden" id="urunId" name="urunId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Ürün:</label>
                        <p class="form-control-plaintext" id="urunAdi">@Model.Ad</p>
                    </div>
                    <div class="mb-3">
                        <label for="puan" class="form-label">Puanınız:</label>
                        <div class="d-flex gap-2">
                            <input type="radio" class="btn-check" name="puan" id="puan1" value="1" required>
                            <label class="btn btn-outline-warning" for="puan1">1 ⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan2" value="2" required>
                            <label class="btn btn-outline-warning" for="puan2">2 ⭐⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan3" value="3" required>
                            <label class="btn btn-outline-warning" for="puan3">3 ⭐⭐⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan4" value="4" required>
                            <label class="btn btn-outline-warning" for="puan4">4 ⭐⭐⭐⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan5" value="5" required>
                            <label class="btn btn-outline-warning" for="puan5">5 ⭐⭐⭐⭐⭐</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="metin" class="form-label">Yorumunuz:</label>
                        <textarea class="form-control" id="metin" name="metin" rows="4"
                                  placeholder="Bu ürün hakkında düşüncelerinizi paylaşın..." maxlength="500" required></textarea>
                        <small class="text-muted">Kalan karakter: <span id="karakterSayisi">500</span></small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Yorum Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function yorumModalAc(urunId, urunAdi) {
        // Kullanıcı giriş yapmış mı kontrol et
    @if (Context.Session.GetString("KullaniciId") == null)
    {
        <text>
                alert('Yorum yapmak için giriş yapmalısınız.');
            window.location.href = '/Auth/Login';
            return;
        </text>
    }

            document.getElementById('urunId').value = urunId;
        document.getElementById('urunAdi').textContent = urunAdi;

        // Modal'ı aç
        var modal = new bootstrap.Modal(document.getElementById('yorumModal'));
        modal.show();
    }

    function yorumSil(yorumId) {
        if (confirm('Yorumunuzu silmek istediğinizden emin misiniz?')) {
            fetch('/Yorum/Sil', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'yorumId=' + yorumId
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    alert('Bir hata oluştu.');
                });
        }
    }

    // Karakter sayısı kontrolü
    document.getElementById('metin').addEventListener('input', function () {
        var kalan = 500 - this.value.length;
        document.getElementById('karakterSayisi').textContent = kalan;

        if (kalan < 50) {
            document.getElementById('karakterSayisi').style.color = 'red';
        } else {
            document.getElementById('karakterSayisi').style.color = 'gray';
        }
    });

    // Form validation
    document.querySelector('#yorumModal form').addEventListener('submit', function (e) {
        var metin = document.getElementById('metin').value.trim();
        var puan = document.querySelector('input[name="puan"]:checked');

        if (!metin) {
            e.preventDefault();
            alert('Lütfen yorum metni girin.');
            return false;
        }

        if (!puan) {
            e.preventDefault();
            alert('Lütfen puan seçin.');
            return false;
        }
    });
</script> 