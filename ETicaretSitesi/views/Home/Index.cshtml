@model List<ETicaretSitesi.models.Urun>
@{
    ViewData["Title"] = "Ana Sayfa";
    var kategori = ViewBag.Kategori as int?;
    var kategoriler = ViewBag.Kategoriler as List<ETicaretSitesi.models.Kategori>;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-4">
    <!-- navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm rounded mb-4">
        <a class="navbar-brand fw-bold" href="#">E-Ticaret Sitem</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Ana Sayfa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Ürünler</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Kategoriler</a>
                </li>
            </ul>
            <form class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Ürün ara..." aria-label="Search">
                <button class="btn btn-outline-success" type="submit">Ara</button>
            </form>
            <a href="/Home/Sepetim" class="btn btn-primary ms-3">
                <i class="bi bi-cart"></i> Sepetim
            </a>
            @if (Context.Session.GetString("KullaniciId") != null)
            {
                <div class="dropdown ms-3">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i> @Context.Session.GetString("KullaniciAd")
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/Auth/Profile"><i class="bi bi-person"></i> Profilim</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/Auth/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                    </ul>
                </div>
            }
            else
            {
                <div class="ms-3">
                    <a href="/Auth/Login" class="btn btn-outline-primary me-2">
                        <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
                    </a>
                    <a href="/Auth/Register" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Kayıt Ol
                    </a>
                </div>
            }
        </div>
    </nav>
    <div class="p-5 mb-4 bg-primary text-white rounded-3 shadow-sm">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">Hoşgeldiniz!</h1>
            <p class="col-md-8 fs-4">En yeni ürünler, avantajlı fiyatlar ve hızlı teslimat ile alışverişin keyfini çıkarın.</p>
            <a href="#" class="btn btn-light btn-lg">Alışverişe Başla</a>
        </div>
    </div>
    <div class="row">
        <!-- Kategori -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Kategoriler</h5>
                </div>
                <ul class="list-group list-group-flush">
                    <a href="/Home/Index" class="list-group-item list-group-item-action @(kategori == null ? "active" : "")">Tümü</a>
                    @if (kategoriler != null)
                    {
                        foreach (var kat in kategoriler)
                        {
                            <a href="/Home/Index?kategori=@kat.Id" class="list-group-item list-group-item-action @(kategori == kat.Id ? "active" : "")">@kat.Isim</a>
                        }
                    }
                </ul>
            </div>
        </div>
        <!-- Ürünler-->
        <div class="col-md-9">
            <h4 class="mb-3">Öne Çıkan Ürünler</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var urun in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <a href="/Home/UrunDetay/@urun.Id" class="text-decoration-none">
                                    <img src="@(string.IsNullOrEmpty(urun.ResimUrl) ? "/images/default.png" : urun.ResimUrl)" class="card-img-top" alt="@urun.Ad" style="cursor: pointer;" />
                                    <div class="card-body">
                                        <h5 class="card-title text-dark">@urun.Ad</h5>
                                        <p class="card-text text-muted">@urun.Aciklama</p>
                                        <span class="badge bg-secondary">@urun.Kategori?.Isim</span>
                                    </div>
                                </a>
                                <div class="card-footer bg-white">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-success">₺@urun.Fiyat</span>
                                        <button class="btn btn-sm btn-outline-info" onclick="yorumModalAc(@urun.Id, '@urun.Ad')">
                                            <i class="bi bi-chat-dots"></i> Yorum Yap
                                        </button>
                                    </div>
                                    <form method="post" action="/Home/SepeteEkle">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="urunId" value="@urun.Id" />
                                        <button type="submit" class="btn btn-primary w-100">Sepete Ekle</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info">Ürün bulunamadı.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Yorum Model -->
<div class="modal fade" id="yorumModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-dots"></i> Yorum Yap
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Yorum/Ekle">
                <div class="modal-body">
                    <input type="hidden" id="urunId" name="urunId" />
                    <div class="mb-3">
                        <label class="form-label">Ürün:</label>
                        <p class="form-control-plaintext" id="urunAdi"></p>
                    </div>
                    <div class="mb-3">
                        <label for="puan" class="form-label">Puanınız:</label>
                        <div class="d-flex gap-2">
                            <input type="radio" class="btn-check" name="puan" id="puan1" value="1" required>
                            <label class="btn btn-outline-warning" for="puan1">1 ⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan2" value="2" required>
                            <label class="btn btn-outline-warning" for="puan2">2 ⭐⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan3" value="3" required>
                            <label class="btn btn-outline-warning" for="puan3">3 ⭐⭐⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan4" value="4" required>
                            <label class="btn btn-outline-warning" for="puan4">4 ⭐⭐⭐⭐</label>

                            <input type="radio" class="btn-check" name="puan" id="puan5" value="5" required>
                            <label class="btn btn-outline-warning" for="puan5">5 ⭐⭐⭐⭐⭐</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="metin" class="form-label">Yorumunuz:</label>
                        <textarea class="form-control" id="metin" name="metin" rows="4"
                                  placeholder="Bu ürün hakkında düşüncelerinizi paylaşın..." maxlength="500" required></textarea>
                        <small class="text-muted">Kalan karakter: <span id="karakterSayisi">500</span></small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Yorum Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function yorumModalAc(urunId, urunAdi) {
        // Kullanıcı giriş yapmış mı kontrol et
    @if (Context.Session.GetString("KullaniciId") == null)
    {
        <text>
                alert('Yorum yapmak için giriş yapmalısınız.');
            window.location.href = '/Auth/Login';
            return;
        </text>
    }

            document.getElementById('urunId').value = urunId;
        document.getElementById('urunAdi').textContent = urunAdi;

        // Modal'ı aç
        var modal = new bootstrap.Modal(document.getElementById('yorumModal'));
        modal.show();
    }

    // Karakter sayısı kontrolü
    document.getElementById('metin').addEventListener('input', function () {
        var kalan = 500 - this.value.length;
        document.getElementById('karakterSayisi').textContent = kalan;

        if (kalan < 50) {
            document.getElementById('karakterSayisi').style.color = 'red';
        } else {
            document.getElementById('karakterSayisi').style.color = 'gray';
        }
    });

    
    document.querySelector('#yorumModal form').addEventListener('submit', function (e) {
        var metin = document.getElementById('metin').value.trim();
        var puan = document.querySelector('input[name="puan"]:checked');

        if (!metin) {
            e.preventDefault();
            alert('Lütfen yorum metni girin.');
            return false;
        }

        if (!puan) {
            e.preventDefault();
            alert('Lütfen puan seçin.');
            return false;
        }
    });
</script> 