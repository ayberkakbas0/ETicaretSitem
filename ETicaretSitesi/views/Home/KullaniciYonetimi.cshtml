@model List<ETicaretSitesi.models.Kullanici>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3><i class="bi bi-people"></i> Kullanıcı Yönetimi</h3>
                <div>
                    <a href="/Admin/AdminPanel" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Admin Paneli
                    </a>
                    <a href="/Home/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-house"></i> Ana Sayfa
                    </a>
                </div>
            </div>
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-people"></i> Kullanıcı Yönetimi
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Mesaj"] != null)
                    {
                        <div class="alert alert-@TempData["MesajTipi"] alert-dismissible fade show" role="alert">
                            @TempData["Mesaj"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Henüz kullanıcı bulunmuyor.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Ad Soyad</th>
                                        <th>Email</th>
                                        <th>Telefon</th>
                                        <th>Kayıt Tarihi</th>
                                        <th>Durum</th>
                                        <th>Rol</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kullanici in Model)
                                    {
                                        <tr id="kullanici-@kullanici.Id">
                                            <td>@kullanici.Id</td>
                                            <td>
                                                <strong>@kullanici.Ad @kullanici.Soyad</strong>
                                            </td>
                                            <td>
                                                <a href="mailto:@kullanici.Email">@kullanici.Email</a>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(kullanici.Telefon))
                                                {
                                                    <a href="tel:@kullanici.Telefon">@kullanici.Telefon</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <small>@kullanici.KayitTarihi.ToString("dd.MM.yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                @if (kullanici.Aktif)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> Aktif
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-x-circle"></i> Pasif
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (kullanici.AdminMi)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-shield-check"></i> Admin
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="bi bi-person"></i> Kullanıcı
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @if (kullanici.Aktif)
                                                    {
                                                        <button class="btn btn-warning btn-sm" onclick="kullaniciPasifYap(@kullanici.Id)" title="Pasif Yap">
                                                            <i class="bi bi-pause-circle"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-success btn-sm" onclick="kullaniciAktifYap(@kullanici.Id)" title="Aktif Yap">
                                                            <i class="bi bi-play-circle"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-info btn-sm" onclick="kullaniciDetay(@kullanici.Id)" title="Detay">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    @if (!kullanici.AdminMi)
                                                    {
                                                        <button class="btn btn-danger btn-sm" onclick="kullaniciSil(@kullanici.Id)" title="Sil">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function kullaniciAktifYap(kullaniciId) {
    if (confirm('Bu kullanıcıyı aktif yapmak istediğinizden emin misiniz?')) {
        fetch('/Admin/KullaniciAktifYap', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `kullaniciId=${kullaniciId}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Hata: ' + data.message);
            }
        });
    }
}

function kullaniciPasifYap(kullaniciId) {
    if (confirm('Bu kullanıcıyı pasif yapmak istediğinizden emin misiniz?')) {
        fetch('/Admin/KullaniciPasifYap', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `kullaniciId=${kullaniciId}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Hata: ' + data.message);
            }
        });
    }
}

function kullaniciDetay(kullaniciId) {
   
    alert('Kullanıcı detayları: ID ' + kullaniciId);
}

function kullaniciSil(kullaniciId) {
    if (confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!')) {
        fetch('/Admin/KullaniciSil', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `kullaniciId=${kullaniciId}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById(`kullanici-${kullaniciId}`).remove();
            } else {
                alert('Hata: ' + data.message);
            }
        });
    }
}
</script> 