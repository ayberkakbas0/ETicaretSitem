@model IEnumerable<ETicaretSitesi.models.Sepet>
@{
    ViewData["Title"] = "Sepetim";
    decimal toplamTutar = 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-cart"></i> Sepetim</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Sepetinizde ürün yok.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                var urun = item.Urun;
                var satirToplam = urun.Fiyat * item.Adet;
                toplamTutar += satirToplam;
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(string.IsNullOrEmpty(urun.ResimUrl) ? "/images/default.png" : urun.ResimUrl)" class="card-img-top" alt="@urun.Ad" style="object-fit:cover; height:220px;" />
                        <div class="card-body">
                            <h5 class="card-title">@urun.Ad</h5>
                            <p class="card-text">@urun.Aciklama</p>
                            <span class="badge bg-secondary mb-2">@urun.Kategori?.Isim</span>
                            <div class="mb-2">
                                <span class="badge bg-success">₺@urun.Fiyat</span>
                                <span class="badge bg-info text-dark">Stok: @urun.Stok</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <form asp-action="AdetGuncelle" asp-controller="Sepet" method="post" style="display:inline;">
                                    <input type="hidden" name="sepetId" value="@item.Urun.Id" />
                                    <button type="submit" name="adet" value="@(item.Adet - 1)" class="btn btn-sm btn-outline-secondary" @(item.Adet == 1 ? "disabled" : "")>-</button>
                                </form>
                                <span class="mx-2 fs-5">@item.Adet</span>
                                <form asp-action="AdetGuncelle" asp-controller="Sepet" method="post" style="display:inline;">
                                    <input type="hidden" name="sepetId" value="@item.Urun.Id" />
                                    <button type="submit" name="adet" value="@(item.Adet + 1)" class="btn btn-sm btn-outline-secondary" @(item.Adet >= urun.Stok ? "disabled" : "")>+</button>
                                </form>
                            </div>
                            <div>
                                <span class="fw-bold">Satır Toplam: </span>
                                <span class="text-success fw-bold">@satirToplam.ToString("C")</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-between">
                            <form asp-action="Sil" asp-controller="Sepet" method="post" style="display:inline;">
                                <input type="hidden" name="sepetId" value="@item.Urun.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="row mt-4">
            <div class="col-12">
                <div class="alert alert-primary fs-5 text-end">
                    <strong>Sepet Toplamı: @toplamTutar.ToString("C")</strong>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between mt-3">
            <form asp-action="SepetiTemizle" asp-controller="Sepet" method="post">
                <button type="submit" class="btn btn-warning">Sepeti Temizle</button>
            </form>
            <form asp-action="Odeme" asp-controller="Sepet" method="get">
                <button type="submit" class="btn btn-success">Ödeme Yap</button>
            </form>
        </div>
    }
</div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</html>