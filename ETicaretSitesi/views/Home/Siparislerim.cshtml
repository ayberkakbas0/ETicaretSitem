@model List<ETicaretSitesi.models.Siparis>
@{
    ViewData["Title"] = "Siparişlerim";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm rounded mb-4">
        <a class="navbar-brand fw-bold" href="/Home/Index">E-Ticaret Sitem</a>
        <div class="navbar-nav ms-auto">
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("KullaniciAd")
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/Auth/Profile"><i class="bi bi-person"></i> Profilim</a></li>
                    <li><a class="dropdown-item active" href="/Home/Siparislerim"><i class="bi bi-box"></i> Siparişlerim</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/Auth/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-box"></i> Siparişlerim
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Mesaj"] != null)
                    {
                        <div class="alert alert-@(TempData["MesajTipi"] ?? "info") alert-dismissible fade show" role="alert">
                            <i class="bi bi-@(TempData["MesajTipi"] == "success" ? "check-circle" :
                                          TempData["MesajTipi"] == "danger" ? "exclamation-triangle" :
                                          TempData["MesajTipi"] == "warning" ? "exclamation-circle" : "info-circle")"></i>
                            @TempData["Mesaj"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-box text-muted" style="font-size: 4rem;"></i>
                            <h5 class="text-muted mt-3">Henüz siparişiniz bulunmuyor</h5>
                            <p class="text-muted">İlk siparişinizi vermek için ürünlerimizi inceleyin.</p>
                            <a href="/Home/Index" class="btn btn-primary">
                                <i class="bi bi-shop"></i> Ürünleri İncele
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="bi bi-hash"></i> Sipariş No</th>
                                        <th><i class="bi bi-calendar"></i> Tarih</th>
                                        <th><i class="bi bi-currency-dollar"></i> Tutar</th>
                                        <th><i class="bi bi-geo-alt"></i> Adres</th>
                                        <th><i class="bi bi-flag"></i> Durum</th>
                                        <th><i class="bi bi-credit-card"></i> Ödeme</th>
                                        <th><i class="bi bi-gear"></i> İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var siparis in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@siparis.Id</strong>
                                            </td>
                                            <td>
                                                @siparis.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")
                                            </td>
                                            <td>
                                                <span class="fw-bold text-success">@siparis.ToplamTutar.ToString("C")</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(siparis.Adres?.Length > 50 ? siparis.Adres.Substring(0, 50) + "..." : siparis.Adres)</small>
                                            </td>
                                            <td>
                                                @{
                                                    var durumClass = siparis.Durum switch
                                                    {
                                                        "Beklemede" => "bg-warning",
                                                        "Onaylandı" => "bg-info",
                                                        "Hazırlanıyor" => "bg-primary",
                                                        "Kargoda" => "bg-info",
                                                        "Teslim Edildi" => "bg-success",
                                                        "İptal Edildi" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @durumClass">@siparis.Durum</span>
                                            </td>
                                            <td>
                                                @{
                                                    var odemeClass = siparis.OdemeDurumu switch
                                                    {
                                                        "Beklemede" => "bg-warning",
                                                        "Tamamlandı" => "bg-success",
                                                        "Ödendi" => "bg-success",
                                                        "Başarısız" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @odemeClass">@siparis.OdemeDurumu</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#siparisDetayModal"
                                                            data-siparis-id="@siparis.Id">
                                                        <i class="bi bi-eye"></i> Detay
                                                    </button>
                                                    @if (siparis.OdemeDurumu == "Beklemede")
                                                    {
                                                        <a href="/Odeme/OdemeSayfasi?siparisId=@siparis.Id"
                                                           class="btn btn-sm btn-success">
                                                            <i class="bi bi-credit-card"></i> Öde
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <hr class="my-4">

                    <div class="d-flex justify-content-between">
                        <a href="/Home/Index" class="btn btn-outline-primary">
                            <i class="bi bi-house"></i> Ana Sayfa
                        </a>
                        <a href="/Auth/Profile" class="btn btn-primary">
                            <i class="bi bi-person"></i> Profilim
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sipariş Detay Modal -->
<div class="modal fade" id="siparisDetayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-box"></i> Sipariş Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="siparisDetayContent">
                <!-- AJAX ile yüklenecek -->
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Sipariş detay modalı için AJAX
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('siparisDetayModal');
        const content = document.getElementById('siparisDetayContent');

        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const siparisId = button.getAttribute('data-siparis-id');

            // AJAX ile sipariş detayını yükle
            fetch(`/Home/SiparisDetayPartial?siparisId=${siparisId}`)
                .then(response => response.text())
                .then(html => {
                    content.innerHTML = html;
                })
                .catch(error => {
                    content.innerHTML = '<div class="alert alert-danger">Sipariş detayı yüklenirken hata oluştu.</div>';
                });
        });
    });
</script> 